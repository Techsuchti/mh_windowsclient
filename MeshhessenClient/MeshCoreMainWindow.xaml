<Window x:Class="MeshhessenClient.MeshCoreMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MeshCore Windows Client" Height="760" Width="1250"
        MinHeight="600" MinWidth="950">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <TextBlock Text="MeshCore" FontSize="28" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text="  Windows Client" FontSize="18" VerticalAlignment="Center" Opacity="0.7"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <TextBlock Text="Transport" VerticalAlignment="Center" Margin="8,0,4,0"/>
                <ComboBox x:Name="TransportComboBox" Width="115" SelectedIndex="0" SelectionChanged="TransportComboBox_SelectionChanged">
                    <ComboBoxItem Content="USB / Serial" Tag="Serial"/>
                    <ComboBoxItem Content="Bluetooth LE" Tag="Bluetooth"/>
                    <ComboBoxItem Content="TCP / Wi-Fi" Tag="Tcp"/>
                </ComboBox>
                <ComboBox x:Name="PortComboBox" Width="110" Margin="8,0"/>
                <ComboBox x:Name="BaudComboBox" Width="95" Margin="4,0" SelectedIndex="0">
                    <ComboBoxItem Content="115200" Tag="115200"/>
                    <ComboBoxItem Content="230400" Tag="230400"/>
                </ComboBox>
                <TextBox x:Name="TcpHostTextBox" Width="150" Margin="8,0" Text="127.0.0.1" Visibility="Collapsed" VerticalContentAlignment="Center"/>
                <TextBox x:Name="TcpPortTextBox" Width="65" Margin="4,0" Text="4403" Visibility="Collapsed" VerticalContentAlignment="Center"/>
                <Button x:Name="RefreshButton" Content="Refresh" Click="RefreshButton_Click" Margin="4,0" Padding="12,6"/>
                <Button x:Name="ConnectButton" Content="Connect" Click="ConnectButton_Click" Margin="4,0" Padding="16,6"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Padding="10" CornerRadius="6" Background="#22000000" Margin="0,0,0,12">
            <DockPanel>
                <TextBlock x:Name="StatusText" Text="Disconnected" FontWeight="SemiBold"/>
                <TextBlock x:Name="DeviceText" DockPanel.Dock="Right" Text="No MeshCore device" Opacity="0.8"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="Contacts" Grid.Column="0" Margin="0,0,8,0">
                <ListBox x:Name="ContactsListBox" DisplayMemberPath="Name" SelectionChanged="ContactsListBox_SelectionChanged"/>
            </GroupBox>

            <GroupBox Header="Channels" Grid.Column="1" Margin="0,0,8,0">
                <ListBox x:Name="ChannelsListBox" DisplayMemberPath="Name" SelectionChanged="ChannelsListBox_SelectionChanged"/>
            </GroupBox>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <GroupBox Header="Messages" Grid.Row="0">
                    <ListBox x:Name="MessagesListBox"/>
                </GroupBox>
                <DockPanel Grid.Row="1" Margin="0,8,0,0">
                    <CheckBox x:Name="DirectMessageCheckBox" Content="DM selected contact" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="MessageTextBox" Height="38" AcceptsReturn="False" VerticalContentAlignment="Center" KeyDown="MessageTextBox_KeyDown"/>
                    <Button Content="Send" Width="90" Margin="8,0,0,0" Click="SendButton_Click"/>
                </DockPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
