<UserControl x:Class="MeshhessenClient.Controls.MeshCoreMapCanvas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#20252B">
    <Grid ClipToBounds="True">
        <Canvas x:Name="MapCanvas" Background="#20252B"
                MouseLeftButtonDown="MapCanvas_MouseLeftButtonDown"
                MouseLeftButtonUp="MapCanvas_MouseLeftButtonUp"
                MouseMove="MapCanvas_MouseMove"
                MouseWheel="MapCanvas_MouseWheel"/>
        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Padding="8"
                Background="#DD1F242A" CornerRadius="6">
            <StackPanel>
                <Button Content="+" Width="34" Height="30" Click="ZoomIn_Click"/>
                <Button Content="−" Width="34" Height="30" Margin="0,4,0,0" Click="ZoomOut_Click"/>
            </StackPanel>
        </Border>
        <TextBlock x:Name="MapStatusText" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                   Margin="12" Foreground="White" Background="#AA1F242A" Padding="8" Text="No GPS nodes"/>
    </Grid>
</UserControl>
