<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishDir>..\public\</PublishDir>
    <AssemblyName>MeshCoreWindowsClient</AssemblyName>
    <Version>2.0.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <Company>MeshCore Community</Company>
    <Product>MeshCore Windows Client</Product>
    <Description>Windows Desktop Client für MeshCore Companion Radios</Description>
  </PropertyGroup>

  <!-- Legacy Meshtastic source remains in git history but is deliberately excluded. -->
  <ItemGroup>
    <Compile Remove="**\*.cs" />
    <Compile Include="App.xaml.cs" />
    <Compile Include="MeshCoreMainWindow.xaml.cs" />
    <Compile Include="Services\IConnectionService.cs" />
    <Compile Include="Services\SerialConnectionService.cs" />
    <Compile Include="Services\Logger.cs" />
    <Compile Include="Services\MeshCore*.cs" />
    <Compile Include="Protocols\MeshCore\**\*.cs" />

    <Page Remove="**\*.xaml" />
    <ApplicationDefinition Remove="**\*.xaml" />
    <ApplicationDefinition Include="App.xaml" />
    <Page Include="MeshCoreMainWindow.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
  </ItemGroup>
</Project>
