<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishDir>..\public\</PublishDir>
    <AssemblyName>MeshCoreWindowsClient</AssemblyName>
    <Version>2.0.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <Company>MeshCore Community</Company>
    <Product>MeshCore Windows Client</Product>
    <Description>Offline-fähiger Windows Client für MeshCore</Description>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Mapsui.Nts" Version="4.1.7" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.3" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
    <PackageReference Include="OxyPlot.Wpf" Version="2.2.0" />
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
    <!-- Temporary compatibility dependencies; removed after MainWindow migration. -->
    <PackageReference Include="Google.Protobuf" Version="3.25.2" />
    <PackageReference Include="Grpc.Tools" Version="2.60.0" PrivateAssets="All" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="ModernWpfUI" Version="0.9.6" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.4.0" />
    <PackageReference Include="MQTTnet" Version="4.3.7.1207" />
    <PackageReference Include="Mapsui" Version="4.1.7" />
    <PackageReference Include="Mapsui.Wpf" Version="4.1.7" />
    <PackageReference Include="Emoji.Wpf" Version="0.3.3" />
  </ItemGroup>
  <ItemGroup>
    <!-- Temporary Meshtastic compatibility layer. Remove after UI/service migration. -->
    <Protobuf Include="..\protobufs\meshtastic\**\*.proto;..\protobufs\nanopb.proto" GrpcServices="None" ProtoRoot="..\protobufs" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="logo_mh_wide.jpg" />
    <None Remove="Resources\app.ico" />
    <Resource Include="logo_mh_wide.jpg" />
    <Resource Include="Resources\app.ico" />
    <Resource Include="Resources\Strings.de.xaml" />
    <Resource Include="Resources\Strings.en.xaml" />
    <EmbeddedResource Include="..\CHANNELS.csv" />
    <EmbeddedResource Include="Resources\VectorMap\**" />
  </ItemGroup>
</Project>
